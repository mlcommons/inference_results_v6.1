# shellcheck shell=bash disable=SC2034
#
# Pinned inputs of the DeepSeek-R1 Vera Rubin (VR) NVL72 TensorRT-LLM + Dynamo image.
# Sourced by the Dockerfile, the sbatch script, prep_src.sh and steps/*.sh. ${VAR:-default} values can be overridden
# from the environment (or with --build-arg in the Dockerfile).

# Base image: NGC TensorRT-LLM devel (aarch64 digest used by the Slurm/enroot build).
BASE_IMAGE_REPO=nvcr.io/nvidia/tensorrt-llm/devel
BASE_IMAGE_TAG=1.3.0rc27
BASE_IMAGE_INDEX_DIGEST=sha256:5165023a470f625a5a79046bb55007d45226c40d5d6e98a56c1a1f8546858c45
BASE_IMAGE_ARM64_DIGEST=sha256:d9f42c1471892a847a1b01f108bcd188cd9be256f97da3113525ba678fa4b694

# TensorRT-LLM source and build flags.
TRTLLM_REPO=${TRTLLM_REPO:-https://github.com/NVIDIA/TensorRT-LLM.git}
TRTLLM_REF=${TRTLLM_REF:-feat/dsr1_26.08}
TRTLLM_COMMIT=${TRTLLM_COMMIT:?Set TRTLLM_COMMIT to the full SHA of the released public feat/dsr1_26.08 branch; see README.md}
TRTLLM_CUDA_ARCHS=107-real
TRTLLM_BUILD_EXTRA="--nvrtc_dynamic_linking --extra-cmake-vars NIXL_ROOT=/opt/nvidia/nvda_nixl"

# CuTe DSL: the public PyPI release pinned by TensorRT-LLM requirements.txt.
CUTLASS_DSL_PUBLIC_VERSION=4.8.0
CUTLASS_DSL_PACKAGES="nvidia-cutlass-dsl nvidia-cutlass-dsl-libs-base nvidia-cutlass-dsl-libs-core nvidia-cutlass-dsl-libs-cu13"
PUBLIC_PYPI=https://pypi.org/simple

# Base packages that must keep their base versions (an install that would move them fails).
PROTECTED_PKGS="torch torchvision torchaudio triton triton_kernels flashinfer-python tensorrt torch_tensorrt torchao cuda-python cuda-bindings nvidia-cudnn-frontend transformer_engine apex"

# FlashInfer and the trtllm-gen FMHA runner JIT header patched by step 45.
FLASHINFER_VERSION=0.6.18.post1
FLASHINFER_FMHA_RUNNER_REL=flashinfer/data/include/flashinfer/trtllm/fmha/fmhaRunner.cuh

# NVIDIA Dynamo (PyPI wheels) and the nats-server / etcd release binaries.
DYNAMO_VERSION=${DYNAMO_VERSION:-1.5.1}
NATS_VERSION=v2.11.9
NATS_ARM64_SHA256=47d7e652eb761d771bc42df04924aae0acf4e026d30ea98faa9bab216cc2e742
ETCD_VERSION=v3.6.9
ETCD_ARM64_SHA256=b51e433724325b66770019c4819d091b8965d2e81c07571a46e0619da1c8ece6
